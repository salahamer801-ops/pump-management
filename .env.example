# نموذج متغيرات البيئة — أسماء فقط، بلا أي قيمة حقيقية.
# انسخه إلى .env عند التشغيل المحلي إن أردت. لا تُرفع ملفات .env إلى المستودع أبدًا.
# منصة Mythex تحقن DATABASE_URL تلقائيًا في المعاينة والاستضافة — لا تُنسخ قيمته إلى أي ملف.

# مطلوب: رابط اتصال PostgreSQL
DATABASE_URL=

# اختياري: منفذ الخادم (الافتراضي في الكود 3001)
PORT=

# اختياري: production في الاستضافة (يضبطه Dockerfile أصلًا)
NODE_ENV=

# اختياري: أصل الواجهة عند نشرها على دومين مختلف عن الخادم (مفصول بفواصل).
# أوامر CORS لا تُفعَّل إطلاقًا إذا بقي فارغًا (الواجهة تصل عبر /api من نفس الأصل).
CORS_ORIGIN=
EXTRA_CORS_ORIGINS=

# اختياري: SSL لقاعدة البيانات المستضافة: require | verify-full | disable.
# اتركه فارغًا لاستخدام sslmode الموجود في DATABASE_URL.
DATABASE_SSL=

# اختياري: عند ضبطه تُمرَّر كل طلبات /api إلى خادمك المنشور خارجيًا (مثل Railway)
# الواجهة تبقى على مسار نسبي /api — لا عنوان مكتوب في كود الواجهة ولا حاجة إلى CORS.
UPSTREAM_API_BASE=

# اختياري: مهلة انتظار الخادم الخارجي بالملّي ثانية (الافتراضي 30000)
UPSTREAM_TIMEOUT_MS=

# اختياري: القيمة 0 تمنع إعادة رمز استعادة كلمة المرور في رد الخادم (يُسلَّم يدويًا
# عبر لوحة مسؤول النظام). الافتراضي 1 = السلوك الحالي بلا تغيير.
RESET_CODE_IN_RESPONSE=
